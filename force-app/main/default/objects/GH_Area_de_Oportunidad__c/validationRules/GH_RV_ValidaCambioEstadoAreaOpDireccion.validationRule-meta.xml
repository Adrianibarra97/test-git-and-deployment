<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>GH_RV_ValidaCambioEstadoAreaOpDireccion</fullName>
    <active>true</active>
    <description>Se valida que la dirección sea ingresada para cambiar de estado</description>
    <errorConditionFormula>AND (
    !ISPICKVAL(GH_pkl_Estado__c, &quot;Sin escalar&quot;),
    ISPICKVAL(GH_pkl_Direccion__c, &quot;&quot;)
)</errorConditionFormula>
    <errorDisplayField>GH_pkl_Direccion__c</errorDisplayField>
    <errorMessage>La dirección es obligatoria para cambiar de estado</errorMessage>
</ValidationRule>
