<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>GH_RV_ValidaMotivoEstatusNoSeSolucionara</fullName>
    <active>true</active>
    <description>Se valida que el motivo sea ingresado cuando el estado es &quot;No se Solucionará&quot;</description>
    <errorConditionFormula>AND (
    ISPICKVAL(GH_pkl_Estado__c, &quot;No se Solucionará&quot;),
    ISPICKVAL(GH_pkl_Motivo__c, &quot;&quot;)
)</errorConditionFormula>
    <errorDisplayField>GH_pkl_Motivo__c</errorDisplayField>
    <errorMessage>El motivo es obligatorio cuando el estado es &quot;No se Solucionará&quot;</errorMessage>
</ValidationRule>
