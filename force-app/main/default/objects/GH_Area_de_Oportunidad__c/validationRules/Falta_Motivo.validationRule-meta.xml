<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Falta_Motivo</fullName>
    <active>true</active>
    <description>Para pasar a el estado &quot;No se Solucionará&quot; se necesita seleccionar un Motivo</description>
    <errorConditionFormula>AND(ISPICKVAL(GH_pkl_Estado__c,&quot;No se Solucionará&quot;),
					ISPICKVAL(GH_pkl_Motivo__c, &quot;&quot;))</errorConditionFormula>
    <errorMessage>Ingrese un &quot;Motivo&quot;</errorMessage>
</ValidationRule>
