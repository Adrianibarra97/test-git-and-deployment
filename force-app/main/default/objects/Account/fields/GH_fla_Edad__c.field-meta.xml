<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>GH_fla_Edad__c</fullName>
    <description>Campo que calcula la edad en base al campo Fecha de Nacimiento</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(PersonBirthdate), NULL, YEAR(TODAY()) - YEAR(PersonBirthdate))</formula>
    <label>Edad</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
