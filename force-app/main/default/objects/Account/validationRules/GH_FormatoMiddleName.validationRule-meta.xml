<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>GH_FormatoMiddleName</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT(ISBLANK(MiddleName )
), NOT ( REGEX( MiddleName , &apos;^[A-ZÜÑ .]*$&apos;)
)
)</errorConditionFormula>
    <errorDisplayField>MiddleName</errorDisplayField>
    <errorMessage>El Segundo Nombre solo puede contener MAYUSCULAS sin acentos</errorMessage>
</ValidationRule>
