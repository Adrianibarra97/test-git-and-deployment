<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>GH_FormatoSuffix</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT(ISBLANK(Suffix )
), NOT ( REGEX( Suffix , &apos;^[A-ZÜÑ .]*$&apos;)
)
)</errorConditionFormula>
    <errorDisplayField>Suffix</errorDisplayField>
    <errorMessage>El Apellido Materno solo puede contener MAYUSCULAS sin acentos</errorMessage>
</ValidationRule>
