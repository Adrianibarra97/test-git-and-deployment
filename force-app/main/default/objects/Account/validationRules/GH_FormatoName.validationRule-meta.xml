<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>GH_FormatoName</fullName>
    <active>true</active>
    <errorConditionFormula>AND( 
	NOT(ISBLANK(FirstName )
	),	
	NOT ( REGEX( FirstName , &apos;^[A-ZÜÑ .]*$&apos;) 
	) 
)</errorConditionFormula>
    <errorDisplayField>FirstName</errorDisplayField>
    <errorMessage>El nombre solo puede contener MAYUSCULAS sin acentos</errorMessage>
</ValidationRule>
